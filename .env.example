# Server-only. Never expose this value through VITE_* variables or commit a real key.
POOLSIDE_API_KEY=

# Public account API origin used by web and desktop clients for account status and project sync.
VITE_NEXDESIGN_ACCOUNT_API=

# Public ECDSA P-256 key used only to verify server-issued offline leases.
# Encode PEM newlines as \n when your environment loader requires a single line.
VITE_NEXDESIGN_OFFLINE_LEASE_PUBLIC_KEY=
